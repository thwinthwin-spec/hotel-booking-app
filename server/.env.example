# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hotel_booking

# Use a long random string in production
JWT_SECRET=dev_only_change_me_please_1234567890
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins, or *
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# Image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe TEST mode keys only (never use live keys here)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# SMTP (leave blank to log emails instead of sending them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Hotel Booking <no-reply@hotelbooking.local>
